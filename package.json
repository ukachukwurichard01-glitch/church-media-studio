{
  "name": "church-media-studio",
  "version": "1.5.0",
  "private": true,
  "description": "Church Media Studio — professional church presentation, motion graphics and broadcast workspace",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "dist": "npm run build:ndi && npm run build && electron-builder",
    "start": "electron .",
    "build:ndi": "cmake -S native -B native/build -A x64 && cmake --build native/build --config Release"
  },
  "dependencies": {
    "react": "*",
    "react-dom": "*",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "*",
    "concurrently": "*",
    "electron": "*",
    "electron-builder": "*",
    "vite": "*",
    "wait-on": "*"
  },
  "build": {
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis",
      "extraResources": [
        {
          "from": "native/build/Release/ndi_sender.exe",
          "to": "ndi/ndi_sender.exe"
        },
        {
          "from": "native/build/Release/Processing.NDI.Lib.x64.dll",
          "to": "ndi/Processing.NDI.Lib.x64.dll"
        }
      ]
    },
    "nsis": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Church Media Studio"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ukachukwurichard01-glitch",
        "repo": "church-media-studio",
        "releaseType": "release"
      }
    ],
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "${productName}-${version}-macOS.${ext}"
    },
    "dmg": {
      "sign": false,
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "directories": {
      "output": "release"
    }
  },
  "author": "MADE BY UKACHUKWU RICHARD AND JAMES GODSWILL",
  "productName": "Church Media Studio"
}
